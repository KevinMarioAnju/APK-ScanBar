<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ModernCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/llAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@color/divider_light"
                android:src="@android:drawable/ic_menu_myplaces"
                android:padding="12dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/llAvatar"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NAMA KONTRAKTOR"
                    android:textColor="@color/text_high"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JABATAN"
                    android:textColor="@color/text_low"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailRegNoTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="1203232"
                android:textColor="@color/text_low"
                android:textSize="10sp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="@color/divider_light" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <LinearLayout style="@style/SheetInfoItem" android:layout_marginBottom="12dp">
                <TextView style="@style/SheetInfoLabel" android:text="NO. REG" />
                <TextView android:id="@+id/tvDetailRegNo" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem" android:layout_marginBottom="12dp">
                <TextView style="@style/SheetInfoLabel" android:text="KONTRAKTOR" />
                <TextView android:id="@+id/tvDetailContractor" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem" android:layout_marginBottom="12dp">
                <TextView style="@style/SheetInfoLabel" android:text="TGL KEJADIAN" />
                <TextView android:id="@+id/tvDetailEventDate" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem" android:layout_marginBottom="12dp">
                <TextView style="@style/SheetInfoLabel" android:text="PLANT/DIVISI" />
                <TextView android:id="@+id/tvDetailPlant" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>
        </GridLayout>

        <LinearLayout
            android:id="@+id/layoutFine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_fine_highlight"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL DENDA"
                android:textColor="@color/alert_terracotta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailFineBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rp -"
                android:textColor="@color/alert_terracotta"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llViolationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvVioTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Pelanggaran"
                android:textColor="@color/text_high"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVioCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_low"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/llViolationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvCleanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kontraktor ini tidak memiliki catatan pelanggaran."
                android:textColor="@color/accent_teal"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailViolationBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill_success"
                android:gravity="center"
                android:padding="12dp"
                android:text="BERSIH"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Hidden for backward compatibility -->
            <TextView android:id="@+id/tvAvatarInitials" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvAddVio" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_violation_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Pelanggaran"
            android:textColor="@color/violation_header"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnRemoveViolation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/violation_header"
            android:contentDescription="Hapus Pelanggaran" />
    </RelativeLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Tanggal Kejadian"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Jenis Pelanggaran"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Denda (Rp)"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioFine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Plant/Divisi"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioPlant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="No. Dokumen"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioDocNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilItemVioInspector"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Nama Penegur"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioInspector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Lokasi Kejadian"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVioLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
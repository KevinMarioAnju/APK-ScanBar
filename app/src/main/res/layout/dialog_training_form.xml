<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Form Training"
            android:textColor="@color/text_high"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llWorkerSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cari &amp; Pilih Kontraktor"
                android:textSize="11sp"
                android:textColor="@color/text_low"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Ketik Nama atau No. Reg"
                app:boxStrokeColor="@color/accent_teal"
                app:hintTextColor="@color/accent_teal"
                app:startIconDrawable="@android:drawable/ic_menu_search">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWorkerSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_high" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWorkerSearch"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_search_modern"
                android:visibility="gone" />
        </LinearLayout>


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Judul Training"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTrainingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tanggal Training"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTrainingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Jam Mulai"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTrainingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Jam Selesai"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTrainingEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Lokasi Training"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTrainingLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelulusan (Pass/Fail)"
                android:textSize="11sp"
                android:textColor="@color/text_low"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />
            <Spinner
                android:id="@+id/spinnerPassFail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_modern"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnTrainingCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal"
                android:textColor="@color/text_medium" />
            <Button
                android:id="@+id/btnTrainingSave"
                style="@style/TealButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Simpan" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
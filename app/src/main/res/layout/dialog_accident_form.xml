<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvAccidentFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Form Kecelakaan"
            android:textColor="@color/text_high"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cari &amp; Pilih Kontraktor"
            android:textSize="11sp"
            android:textColor="@color/text_low"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp" />

        <!-- Worker Search (Similar to Training Form) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWorkerSearch"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Nama atau No. Reg"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal"
            app:startIconDrawable="@android:drawable/ic_menu_search">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccidentWorkerSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAccidentWorkerSearch"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_search_modern"
            android:visibility="gone" />


        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tanggal Kecelakaan"
            app:helperText="Contoh: 11/08/2024"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccidentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Jam Kecelakaan"
            app:helperText="Contoh: 14:30"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccidentTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Lokasi Kecelakaan"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccidentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keparahan Kecelakaan"
            android:textSize="11sp"
            android:textColor="@color/text_medium"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp" />

        <Spinner
            android:id="@+id/spinnerAccidentSeverity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_search_modern"
            android:paddingHorizontal="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Kronologis Kecelakaan"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccidentChronology"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top"
                android:padding="12dp"
                android:textSize="14sp"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAccidentCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal"
                android:textColor="@color/text_medium" />
            <Button
                android:id="@+id/btnAccidentSave"
                style="@style/TealButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Simpan" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
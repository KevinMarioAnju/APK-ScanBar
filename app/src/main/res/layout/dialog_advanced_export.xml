<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Advanced Export"
        android:textColor="@color/text_high"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Cakupan Data"
        android:textSize="12sp"
        android:textColor="@color/text_low"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgExportScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbExportAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Semua Data"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbExportFiltered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hasil Filter Saat Ini" />

        <RadioButton
            android:id="@+id/rbExportModified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hanya Input di HP" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvFilterDropdownLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Kategori Filter"
        android:textSize="12sp"
        android:textColor="@color/text_low"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilExportCategory"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <AutoCompleteTextView
            android:id="@+id/actvExportCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="Semua" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limit Jumlah Data (Kosongkan jika semua)"
        android:textSize="12sp"
        android:textColor="@color/text_low"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="@color/accent_teal"
        app:hintTextColor="@color/accent_teal">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etExportLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: 10"
            android:inputType="number"
            android:textColor="@color/text_high" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSelectSpecificData"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Data Spesifik (Select Data)"
        android:textColor="@color/accent_teal"
        android:textSize="11sp"
        android:layout_gravity="end"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Format"
        android:textSize="12sp"
        android:textColor="@color/text_low"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgExportFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbExportCSV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CSV"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbExportXLS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Excel" />

        <RadioButton
            android:id="@+id/rbExportPDF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="PDF" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExportCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:textColor="@color/text_medium" />

        <Button
            android:id="@+id/btnExportExecute"
            style="@style/TealButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Export Sekarang" />
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVioFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Form Pelanggaran"
            android:textColor="@color/text_high"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Pelanggaran"
                android:textSize="12sp"
                android:textColor="@color/text_low"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp" />
            <Spinner
                android:id="@+id/spinnerVioType"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_search_modern"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Tanggal"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVioDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Lokasi"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVioLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Catatan"
            app:boxStrokeColor="@color/accent_teal"
            app:hintTextColor="@color/accent_teal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVioNotes"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:textColor="@color/text_high" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Hidden Close button for compatibility -->
            <View android:id="@+id/btnVioClose" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <Button
                android:id="@+id/btnVioCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal"
                android:textColor="@color/text_medium" />
            <Button
                android:id="@+id/btnVioSave"
                style="@style/TealButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Simpan" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAMA PEKERJA"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvRegNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="REG NO: 1203232"
                android:textColor="@color/text_low"
                android:textSize="12sp" />

            <!-- Status Badges Row (Horizontal Scrollable) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/statusContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill_violation"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="1 Pelanggaran"
                        android:textColor="@color/semantic_error_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatusReprimand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill_reprimand"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="1 Teguran"
                        android:textColor="@color/semantic_warning_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatusAccident"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill_accident"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="1 Kecelakaan"
                        android:textColor="@color/semantic_error_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatusTraining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill_info"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="1 Pelatihan"
                        android:textColor="#00B894"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvStatusClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_pill_clean"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Bersih"
                        android:textColor="@color/semantic_success_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Data Grid 2 Column -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JABATAN"
                        android:textSize="11sp"
                        android:textColor="@color/text_low"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:id="@+id/tvPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Position"
                        android:textColor="@color/text_medium"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KONTRAKTOR"
                        android:textSize="11sp"
                        android:textColor="@color/text_low"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />
                    <TextView
                        android:id="@+id/tvContractor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contractor Name"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/text_medium"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <!-- Actions Grid 3 Column -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3">

            <TextView
                android:id="@+id/btnViolation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:paddingVertical="12dp"
                android:text="Pelanggaran"
                android:gravity="center"
                android:textColor="@color/semantic_error_main"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:paddingVertical="12dp"
                android:text="Edit"
                android:gravity="center"
                android:textColor="@color/semantic_action_netral"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:paddingVertical="12dp"
                android:text="Hapus"
                android:gravity="center"
                android:textColor="@color/semantic_error_main"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground" />
        </GridLayout>

        <!-- Hidden fields for compatibility -->
        <View android:id="@+id/tvEventDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/tvVioType" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/tvFine" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/tvPlant" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/tvLocation" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/tvDocNo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="48dp">

        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="#E2E8F0" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvSheetRegNo"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSheetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NAMA PEKERJA"
                    android:textColor="@color/text_high"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSheetPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JABATAN"
                    android:textColor="@color/text_low"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSheetRegNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                android:text="1203232"
                android:textColor="@color/text_low"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="@color/divider_light" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <LinearLayout style="@style/SheetInfoItem">
                <TextView style="@style/SheetInfoLabel" android:text="NO. REGISTRASI" />
                <TextView android:id="@+id/tvSheetRegNoGrid" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem">
                <TextView style="@style/SheetInfoLabel" android:text="JABATAN" />
                <TextView android:id="@+id/tvSheetPositionGrid" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem">
                <TextView style="@style/SheetInfoLabel" android:text="KONTRAKTOR" />
                <TextView android:id="@+id/tvSheetContractor" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem">
                <TextView style="@style/SheetInfoLabel" android:text="PLANT / DIVISI" />
                <TextView android:id="@+id/tvSheetPlantDiv" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>

            <LinearLayout style="@style/SheetInfoItem">
                <TextView style="@style/SheetInfoLabel" android:text="SUMBER DATA" />
                <TextView android:id="@+id/tvSheetDataSource" style="@style/SheetInfoValue" android:text="-" />
            </LinearLayout>
        </GridLayout>

        <!-- Actions Grid (2 Rows x 2 Columns) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Baris Pertama: Pelanggaran & Kecelakaan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvSheetViolationBadge"
                    style="@style/SmoothViolationButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TAMBAH PELANGGARAN"
                    android:textSize="9sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvSheetAccidentBadge"
                    style="@style/SmoothAccidentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="TAMBAH KECELAKAAN"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Baris Kedua: Training & Teguran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tvSheetTrainingBadge"
                    style="@style/SmoothTrainingButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TAMBAH TRAINING"
                    android:textSize="9sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNoteSheet"
                    style="@style/SmoothTeguranButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="BERIKAN TEGURAN"
                    android:textSize="9sp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconSize="14dp"
                    app:iconPadding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llViolationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riwayat Pelanggaran"
                    android:textColor="@color/violation_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSheetViolationCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill_violation"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llViolationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llReprimandSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvSheetReprimandLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riwayat Teguran (Catatan)"
                    android:textColor="@color/reprimand_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSheetReprimandCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill_reprimand"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llReprimandList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llTrainingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riwayat Pelatihan (Training)"
                    android:textColor="@color/accent_teal"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSheetTrainingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill_info"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTrainingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAccidentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riwayat Kecelakaan"
                    android:textColor="@color/accident_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSheetAccidentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_pill_accident"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAccidentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_fine_gradient"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL DENDA TERAKUMULASI"
                android:textColor="@color/violation_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvSheetFine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rp -"
                android:textColor="@color/violation_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ScanBar" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.ScanBar" parent="Base.Theme.ScanBar">
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Modern Button Styles -->
    <style name="SmoothViolationButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/semantic_error_main</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="SmoothAccidentButton" parent="SmoothViolationButton">
        <item name="backgroundTint">@color/semantic_error_main</item>
    </style>

    <style name="SmoothTeguranButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/semantic_warning_bg</item>
        <item name="android:textColor">@color/semantic_warning_text</item>
        <item name="iconTint">@color/semantic_warning_text</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ModernCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0.5dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider_light</item>
    </style>

    <style name="TealButtonStyle" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider_light</item>
    </style>

    <!-- Bottom Sheet Styles -->
    <style name="SheetInfoItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>

    <style name="SheetInfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_low</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SheetInfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
</resources>